# Etherana Coder - Environment Variables Example
# Copy this file to .env and fill in your values

# --- AI Provider API Keys ---
# Get your keys from the respective provider consoles

# Anthropic: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-key...

# OpenAI: https://platform.openai.com/
OPENAI_API_KEY=sk-proj-key...

# Google Gemini: https://aistudio.google.com/
GOOGLE_API_KEY=AIzaSy...

# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-key...

# OpenRouter: https://openrouter.ai/
OPENROUTER_API_KEY=sk-or-key...

# Groq: https://console.groq.com/
GROQ_API_KEY=gsk_key...

# Mistral: https://console.mistral.ai/
MISTRAL_API_KEY=api-key...

# xAI (Grok): https://console.x.ai/
XAI_API_KEY=xai-key...

# --- Local & Self-Hosted Providers ---
# Endpoints for local models (default values shown)

OLLAMA_ENDPOINT=http://localhost:11434
LM_STUDIO_ENDPOINT=http://localhost:1234/v1
VLLM_ENDPOINT=http://localhost:8000/v1
LITELLM_ENDPOINT=http://localhost:4000

# --- Advanced Configuration ---
# Optional: Set to 'true' to enable debug logging
DEBUG_MODE=false

# Optional: Custom user agent for API requests
USER_AGENT=Etherana-Coder/1.0
